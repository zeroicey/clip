# Relay clip service configuration.
#
# Install to /data/services/clip/clip.env, owned root:root with mode 0600. The
# DATABASE_URL contains a password and must not be world-readable.

# Loopback only: the public path in is the frp tunnel, which connects locally.
LISTEN_ADDR=127.0.0.1:8790

# The public origin. This service owns the root of its host, so there is no path
# prefix — that is the whole reason the clipboard lives on its own subdomain:
# `https://clip.hcyj.xyz/ops1` is short enough to retype from one screen to
# another.
PUBLIC_BASE_URL=https://clip.hcyj.xyz

ENVIRONMENT=production
# ^ production also switches Gin out of debug mode (no route-table dump on every
# start) and makes a listen failure exit non-zero, so systemd reports it as a
# failure rather than a clean stop.

# Postgres. The database is `relay` on the shared local instance; the role owns
# nothing else and has no superuser rights.
DATABASE_URL=postgres://relay:CHANGE_ME@127.0.0.1:5432/relay?sslmode=disable
CLIP_DB_MAX_CONNS=8

# How long a new clip lives unless its creator says otherwise. Go durations have
# no day unit: 168h is a week.
CLIP_DEFAULT_TTL=24h

# Limits. These are the numbers that stand between an anonymous public write
# endpoint and a flooded disk.
CLIP_MAX_BODY_BYTES=262144
CLIP_MAX_ASSET_BYTES=5242880
CLIP_MAX_ASSETS=4
CLIP_WRITE_PER_HOUR=30

# The anti-flood budget: requests per MINUTE per source address, for every
# request (reads included). The write budget above is much tighter but covers
# only writes; this one is what stands between an anonymous public read path and
# a scraper driving the database. One open tab re-polls roughly 2.4 times a
# minute, so 240 leaves room for many tabs and still bites a scanner. 0 disables.
CLIP_REQUEST_PER_MINUTE=240

# Bans. A source that is refused CLIP_BAN_AFTER times inside CLIP_BAN_WINDOW is
# blocked for CLIP_BAN_FOR; each further ban doubles, capped at CLIP_BAN_MAX_FOR.
# Only 429s (a spent budget) charge a strike — never a 401, because opening a
# locked clip without its password is a normal page load, not an attack.
# A trusted peer (loopback / private / the tunnel entry point) is NEVER banned:
# a ban there would refuse every client at once. CLIP_BAN_AFTER=0 disables bans.
CLIP_BAN_AFTER=5
CLIP_BAN_WINDOW=10m
CLIP_BAN_FOR=15m
CLIP_BAN_MAX_FOR=24h

# How many long polls one source address may park at once. Past it the poll is
# answered immediately instead of waiting, which is slower but still correct.
# 0 disables the per-source cap (the hub's global cap still applies).
CLIP_MAX_POLLS_PER_IP=8

# Failed secret-guessing budget, per source address AND per target (a clip suffix
# or a share token). Only FAILURES are charged, so an honest reader that re-sends
# its password on every long poll never exhausts it; the point is to make guessing
# expensive. For a share carrying a 6-digit pickup code this per-target bucket is
# what keeps a 10^6 space out of reach.
CLIP_UNLOCK_PER_HOUR=20

# How long a server-generated 6-digit pickup code stays valid. Short on purpose:
# 100万 possibilities are only safe behind a short window plus the guess budget
# above. A code share is never allowed to outlive this, whatever the creator asks.
CLIP_SHARE_CODE_TTL=30m
CLIP_MAX_TOTAL_CLIPS=20000
CLIP_MAX_TOTAL_BYTES=1073741824

# Global kill switch: set to false to make the service read-only without taking
# it down or losing content.
CLIP_WRITES_ENABLED=true
